# V.A.R.I.O — Example environment file
#
# Copy this to `.env` and fill in real values. NEVER commit the real `.env`.
# `.env` and friends are gitignored. Ask a maintainer for actual secret values —
# don't invent or share them.

# ── Core ─────────────────────────────────────────────────────────────────────
# JWT signing secret for VARIO-issued tokens (auth module). Use a long random string.
# Required: docker compose refuses to start without it.
JWT_SECRET=
# JWT lifetime, in minutes.
JWT_EXPIRY_MINUTES=60

# Shared secret for gateway-to-IT-runtime retraining calls; generate a long random value.
RETRAINING_INTERNAL_TOKEN=
# API listen port for the FastAPI gateway.
API_PORT=8000

# ── Database (local PostgreSQL) ─────────────────────────────────────────────
# Native gateway runs only; Compose builds the gateway's URL from POSTGRES_* below.
# Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://vario:vario@localhost:5432/vario

# ── Rasa role-pack instances (one per role pack) ─────────────────────────────
# Native runs only; Compose wires the gateway to its own Rasa containers.
RASA_HR_URL=http://localhost:5005
RASA_IT_URL=http://localhost:5006
RASA_ADMISSIONS_URL=http://localhost:5007

# ── Chat engine tuning (slice-05, see docs/decisions/ADR-002) ────────────────
# Top intent below this confidence → clarification prompt, not a workflow (FR-2).
CONFIDENCE_THRESHOLD=0.4
# Conversation session lifetime in minutes.
SESSION_TTL_MINUTES=60

# ── Integration adapters → Mock internal services ───────────────────────────
# In dev these point at the mock FastAPI services; in prod they'd point at the
# organization's real systems. Same interface either way. Native runs only.
MOCK_AUTH_URL=http://localhost:9001
MOCK_HRMS_URL=http://localhost:9002
MOCK_ITSM_URL=http://localhost:9003
MOCK_ADMISSIONS_URL=http://localhost:9004

# ── Rephraser service (variant + phrase generation) ─────────────────────────
# Provider-agnostic. Default provider is Gemini via Google AI Studio (free tier).
# Switch providers (e.g. openai) via this var — the service selects the backend.
REPHRASER_PROVIDER=gemini
# API key for the selected provider. Optional: without it, admins type variants by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=   # only needed if REPHRASER_PROVIDER=openai

# ── Text-to-Speech (talk mode) ──────────────────────────────────────────────
# Path to the Google Cloud service-account JSON with Text-to-Speech access.
# TTS degrades gracefully to text-only if unset, missing or out of credits.
# Compose ignores this and mounts ./secrets/gcp-tts-sa.json if that file exists.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-tts-sa.json

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Base URL the browser uses to reach the VARIO API. Keep /api: Next.js proxies it
# to the gateway (API_PROXY_TARGET, default http://localhost:8000), so other laptops
# only need port 3000. Compose always builds with /api.
NEXT_PUBLIC_API_BASE_URL=/api

# ── Docker Compose (local dev) ───────────────────────────────────────────
# Used by the Compose postgres service. POSTGRES_PASSWORD is required.
POSTGRES_USER=vario
POSTGRES_PASSWORD=vario
POSTGRES_DB=vario
# Host ports (published on 127.0.0.1, except the frontend). Change one if it's taken,
# e.g. POSTGRES_PORT=5433 when a native PostgreSQL already uses 5432.
# POSTGRES_PORT=5432
# FRONTEND_PORT=3000

# ── CI ───────────────────────────────────────────────────────────────────────
# CI validates code and builds; no cloud deployment secrets are required.
